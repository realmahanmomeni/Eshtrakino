# Server ports (verified free via ss -tuln):
# - PostgreSQL host: 5433 (maps to container 5432)
# - Bot health HTTP: 3100

POSTGRES_USER=eshtrakino
POSTGRES_PASSWORD=change_me
# URL-encoded form of POSTGRES_PASSWORD for Compose DATABASE_URL (@ → %40, etc.)
POSTGRES_PASSWORD_URLENC=change_me
POSTGRES_DB=eshtrakino
POSTGRES_HOST_PORT=5433
BOT_HEALTH_PORT=3100

# Host-side Prisma tooling (bot container overrides host to postgres:5432)
# connection_limit caps the Prisma pool to avoid exhausting Postgres connections
DATABASE_URL=postgresql://eshtrakino:change_me@127.0.0.1:5433/eshtrakino?schema=public&connection_limit=5

BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

INVOICE_TTL_HOURS=5

PAYMENT_GATEWAY=balance

# Swap Wallet (API key + wallet address via admin panel → SystemSetting; env is fallback)
SWAPPAY_WALLET_ADDRESS=
SWAPPAY_WALLET_NETWORK=BSC
SWAPPAY_POLL_INTERVAL_SEC=90

# Comma-separated Telegram numeric IDs (e.g. 123456,789012)
ADMIN_IDS=123456,789012

# Canboso supplier catalog lazy-sync TTL (ms). Default 180000 (3 min). FX rate TTL stays ~30 min.
# CANBOSO_CATALOG_TTL_MS=180000
